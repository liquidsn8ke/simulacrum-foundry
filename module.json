{
  "id": "simulacrum-pf2e",
  "title": "Simulacrum PF2e: AI Document Builder",
  "description": "A fork of Simulacrum specialised for Pathfinder Second Edition. An agent in the sidebar turns stat blocks, abilities, items, spells, hazards and other rules text into working PF2e documents: it reads the system's compendia and data shapes, proposes how each part will be automated (rule elements first, then installed modules, then scripts), builds the document after the GM confirms, and helps verify it in play. GM only.",
  "authors": [
    {
      "name": "liquidsn8ke",
      "url": "https://github.com/liquidsn8ke"
    },
    {
      "name": "Ebonhawk (automation-builder fork)",
      "url": "https://github.com/Ebonhawk3829"
    },
    {
      "name": "Daxiongmao87 (original Simulacrum)",
      "url": "https://github.com/Daxiongmao87"
    }
  ],
  "version": "0.10.0",
  "compatibility": {
    "minimum": "14.369",
    "verified": "14.369"
  },
  "relationships": {
    "systems": [
      {
        "id": "pf2e",
        "type": "system",
        "compatibility": {
          "minimum": "8.4.1",
          "verified": "8.7.0"
        }
      }
    ],
    "requires": [],
    "recommends": [
      {
        "id": "pf2e-toolbelt",
        "type": "module",
        "reason": "Its target and template helpers resolve area saves and apply damage per target, which covers aura and area abilities that rule elements cannot automate on their own."
      },
      {
        "id": "xdy-pf2e-workbench",
        "type": "module",
        "reason": "Optional automation the builder can fall back on when a rule element cannot express an ability."
      }
    ],
    "conflicts": [],
    "flags": {}
  },
  "esmodules": ["scripts/simulacrum.js"],
  "styles": ["styles/simulacrum.css"],
